# Copy to .env (which git ignores) and fill in. Read by docker-compose.yml.

# Base64 of 32+ random bytes, e.g.: openssl rand -base64 32
JWT_SECRET=

# Encrypts secrets stored in the database (two-step login). Also: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Optional: real email for verification and password-reset codes (e.g. Brevo SMTP).
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=

DB_PASSWORD=bank

# Optional first admin account, created at startup if it doesn't exist.
ADMIN_EMAIL=admin@bank.local
ADMIN_PASSWORD=change-me-please
